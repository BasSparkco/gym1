# Root .env — read by docker-compose at build/start time.
# Copy to .env and fill in your values before deploying.

# Public domain pointing to this server (no https://, no trailing slash)
DOMAIN=gym.example.com

# Email used for Let's Encrypt certificate registration
CERTBOT_EMAIL=you@example.com

# Postgres password for the `db` service (shared with the api service's DATABASE_URL)
POSTGRES_PASSWORD=changeme-generate-a-strong-one

# Redis password for the `redis` service (shared with the api service's REDIS_URL)
REDIS_PASSWORD=changeme-generate-a-strong-one

# MinIO credentials for the `minio` service (shared with the api service's MINIO_* vars)
MINIO_ROOT_USER=changeme-generate-a-strong-one
MINIO_ROOT_PASSWORD=changeme-generate-a-strong-one
