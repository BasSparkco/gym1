// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Pinned: without this, generate infers the import extension from the
  // surrounding project. Inside the Docker builder, the generate postinstall
  // runs before tsconfig.json is copied in, and the inference picked ".ts" —
  // producing a client that crashes at runtime with "Cannot find module
  // './internal/class.ts'" (2026-07-10 outage).
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum BranchStatus {
  active
  inactive
}

enum LogoMode {
  shared
  perBranch
}

enum EmployeeStatus {
  active
  inactive
}

enum Sex {
  male
  female
}

enum WorkType {
  fullTime
  partTime
  trainee
}

enum MemberStatus {
  active
  inactive
}

enum PlanType {
  duration
  session
}

enum MembershipStatus {
  draft
  active
  frozen
  expired
  cancelled
}

enum AccessMethod {
  manual
  qr
  rfid
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  cancelled
}

enum PaymentMethod {
  cash
  card
  transfer
}

enum NotificationChannel {
  sms
  whatsapp
  email
}

enum NotificationEvent {
  membershipExpiring
  membershipExpired
  paymentPending
  membershipActivated
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum UserRole {
  owner
  manager
  frontDesk
}

enum ClassSessionStatus {
  scheduled
  cancelled
  completed
}

enum ClassBookingStatus {
  booked
  waitlisted
  attended
  noShow
  cancelled
}

// ── Tenant ───────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id
  name      String
  createdAt DateTime @default(now())

  branches         Branch[]
  employees        Employee[]
  gates            Gate[]
  members          Member[]
  membershipPlans  MembershipPlan[]
  payments         Payment[]
  notifications    Notification[]
  settings         TenantSettings?
  users            User[]
  trainingPrograms TrainingProgram[]
  classSessions    ClassSession[]
}

// ── Branches / Employees / Gates ─────────────────────────────────────────────

model Branch {
  id                    String       @id
  tenantId              String
  tenant                Tenant       @relation(fields: [tenantId], references: [id])
  name                  String
  address               String?
  phone                 String?
  countryCode           String?
  operatingCurrencyCode String       @default("ILS")
  status                BranchStatus @default(active)
  logoUrl               String?

  employees        Employee[]
  gates            Gate[]
  visits           Visit[]
  membersAtHome    Member[]          @relation("MemberHomeBranch")
  payments         Payment[]
  trainingPrograms TrainingProgram[]
  classSessions    ClassSession[]

  @@index([tenantId])
}

model Employee {
  id             String         @id
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  employeeNumber String
  fullName       String
  status         EmployeeStatus @default(active)
  idNumber       String?
  phone          String?
  sex            Sex?
  dateOfBirth    DateTime?      @db.Date
  job            String?
  salary         Decimal?       @db.Decimal(10, 2)
  workType       WorkType?
  startDate      DateTime?      @db.Date
  endDate        DateTime?      @db.Date
  isUser         Boolean        @default(false)

  gates              EmployeeGate[]
  registeredMembers  Member[]          @relation("MemberRegisteredEmployee")
  coachProfile       CoachProfile?
  defaultForPrograms TrainingProgram[]
  classSessions      ClassSession[]
  user               User?

  @@unique([tenantId, employeeNumber])
  @@index([branchId])
}

// A Coach is not a separate person record — it's an Employee extended with
// coaching-specific data, mirroring the TenantSettings-on-Tenant pattern.
// An employee becomes a coach by gaining this row, not by a new entity.
model CoachProfile {
  employeeId      String   @id
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  specializations String[]
  certifications  String[]
}

model Gate {
  id                String  @id
  tenantId          String
  tenant            Tenant  @relation(fields: [tenantId], references: [id])
  branchId          String
  branch            Branch  @relation(fields: [branchId], references: [id])
  name              String
  genderRestriction Sex?
  deviceUrl         String
  deviceUsername    String
  devicePassword    String
  lockNumber        Int
  enabled           Boolean @default(true)

  employees EmployeeGate[]
  visits    Visit[]

  @@index([branchId])
}

model EmployeeGate {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  gateId     String
  gate       Gate     @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@id([employeeId, gateId])
}

// ── Members / Memberships ────────────────────────────────────────────────────

model Member {
  id                    String        @id
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id])
  homeBranchId          String
  homeBranch            Branch        @relation("MemberHomeBranch", fields: [homeBranchId], references: [id])
  memberNumber          String
  fullName              String
  status                MemberStatus?
  phone                 String?
  email                 String?
  dateOfBirth           DateTime?     @db.Date
  sex                   Sex?
  idNumber              String?
  address               String?
  joinDate              DateTime?     @db.Date
  height                Float?
  weight                Float?
  registeredEmployeeId  String?
  registeredEmployee    Employee?     @relation("MemberRegisteredEmployee", fields: [registeredEmployeeId], references: [id], onDelete: SetNull)
  pictureUrl            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalNotes          String?
  rfidTag               String?
  // Hashed PIN a member uses to sign into the mobile app (scrypt, same
  // format as User.passwordHash). Null until staff assigns one — most
  // members won't have the mobile app, so this is opt-in per member.
  pinHash               String?

  memberships   Membership[]
  visits        Visit[]
  payments      Payment[]
  notifications Notification[]
  classBookings ClassBooking[]
  programEnrollments ProgramEnrollment[]

  @@unique([tenantId, memberNumber])
  @@unique([tenantId, rfidTag])
  @@index([homeBranchId])
}

model MembershipPlan {
  id               String   @id
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  name             String
  planType         PlanType @default(duration)
  durationDays     Int?
  sessionCount     Int?
  price            Decimal  @db.Decimal(10, 2)
  allowAllBranches Boolean  @default(true)
  freezeAllowed    Boolean  @default(false)
  freezeMaxDays    Int?
  allowAllPrograms Boolean  @default(true)

  memberships      Membership[]
  entitledPrograms MembershipPlanProgram[]

  @@index([tenantId])
}

// Exception list of Training Programs a plan may book, used only when
// allowAllPrograms is false (mirrors allowAllBranches — most plans allow
// everything; premium/add-on plans restrict to specific programs).
model MembershipPlanProgram {
  planId    String
  plan      MembershipPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  programId String
  program   TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([planId, programId])
}

model Membership {
  id                   String           @id
  memberId             String
  member               Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId               String
  plan                 MembershipPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate            DateTime         @db.Date
  endDate              DateTime         @db.Date
  status               MembershipStatus
  finalPrice           Decimal          @db.Decimal(10, 2)
  previousMembershipId String?          @unique
  previousMembership   Membership?      @relation("MembershipRenewalChain", fields: [previousMembershipId], references: [id], onDelete: SetNull)
  renewedInto          Membership?      @relation("MembershipRenewalChain")

  freezes       Freeze[]
  payments      Payment[]
  classBookings ClassBooking[]

  @@index([memberId])
  @@index([planId])
  @@index([status, endDate])
}

model Freeze {
  id           String     @id
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  startDate    DateTime   @db.Date
  endDate      DateTime   @db.Date
  createdAt    DateTime   @default(now())

  @@index([membershipId])
}

// ── Training Programs / Classes / Bookings ───────────────────────────────────

model TrainingProgram {
  id             String    @id
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  branchId       String? // null = global across the tenant's branches
  branch         Branch?   @relation(fields: [branchId], references: [id])
  name           String
  description    String?
  color          String?
  icon           String?
  active         Boolean   @default(true)
  maxMembers     Int?
  defaultCoachId String?
  defaultCoach   Employee? @relation(fields: [defaultCoachId], references: [id], onDelete: SetNull)

  classSessions    ClassSession[]
  entitledForPlans MembershipPlanProgram[]
  enrolledMembers  ProgramEnrollment[]

  @@index([tenantId])
  @@index([branchId])
}

// Standing enrollment of a member in a training program, independent of any
// specific ClassSession booking (a member can be "in CrossFit" without being
// booked into a particular class time).
model ProgramEnrollment {
  memberId   String
  member     Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  programId  String
  program    TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrolledAt DateTime        @default(now())

  @@id([programId, memberId])
  @@index([memberId])
}

model ClassSession {
  id           String             @id
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  branchId     String
  branch       Branch             @relation(fields: [branchId], references: [id])
  programId    String
  program      TrainingProgram    @relation(fields: [programId], references: [id])
  coachId      String?
  coach        Employee?          @relation(fields: [coachId], references: [id], onDelete: SetNull)
  room         String?
  date         DateTime           @db.Date
  startTime    DateTime
  endTime      DateTime
  capacity     Int
  status       ClassSessionStatus @default(scheduled)
  recurrenceId String? // groups sessions generated from the same recurring rule

  bookings ClassBooking[]

  @@index([tenantId, branchId, date])
  @@index([coachId, date])
  @@index([recurrenceId])
}

model ClassBooking {
  id             String             @id
  classSessionId String
  classSession   ClassSession       @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipId   String
  membership     Membership         @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  status         ClassBookingStatus @default(booked)
  bookedAt       DateTime           @default(now())
  cancelledAt    DateTime?
  visitId        String?            @unique
  visit          Visit?             @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@unique([classSessionId, memberId])
  @@index([memberId])
  @@index([classSessionId, status])
}

// ── Visits / Payments / Notifications ────────────────────────────────────────

model Visit {
  id           String       @id
  memberId     String
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  checkInTime  DateTime
  checkOutTime DateTime?
  accessMethod AccessMethod
  gateId       String?
  gate         Gate?        @relation(fields: [gateId], references: [id], onDelete: SetNull)

  classBooking ClassBooking?

  @@index([memberId])
  @@index([branchId, checkInTime])
  @@index([memberId, branchId, checkOutTime])
}

model Payment {
  id            String        @id
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  memberId      String
  member        Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipId  String
  membership    Membership    @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(10, 2)
  paymentDate   DateTime
  status        PaymentStatus
  paymentMethod PaymentMethod

  @@index([tenantId, branchId])
  @@index([memberId])
  @@index([status, paymentDate])
}

model Notification {
  id           String              @id
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  memberId     String
  member       Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  channel      NotificationChannel
  event        NotificationEvent?
  relatedId    String?
  subject      String
  body         String              @db.Text
  status       NotificationStatus
  sentAt       DateTime?
  failedReason String?             @db.Text
  createdAt    DateTime            @default(now())

  @@index([tenantId, createdAt])
  @@index([memberId])
}

// ── Settings ──────────────────────────────────────────────────────────────────

model TenantSettings {
  tenantId                String   @id
  tenant                  Tenant   @relation(fields: [tenantId], references: [id])
  defaultLanguage         String   @default("en")
  enabledLanguages        String[] @default(["en", "ar", "he"])
  notificationSettings    Json
  notificationSenders     Json     @default("{}")
  dateFormat              String   @default("dd/mm/yyyy")
  checkOutTrackingEnabled Boolean  @default(true)
  ownerDataScope          String   @default("all")
  reportingCurrencyCode   String   @default("ILS")
  logoMode                LogoMode @default(shared)
  logoUrl                 String?
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model User {
  id           String    @id
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  email        String
  username     String
  name         String
  role         UserRole
  passwordHash String
  branchId     String
  branchName   String
  // Optional 1:1 link to the person's Employee record (an account is an
  // optional extension of an employee, like CoachProfile — some users, e.g.
  // the owner, have no employee record). @unique = one account per employee.
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@unique([tenantId, username])
}

// Session records now live in Redis (see src/redis/), not Postgres — see
// AuthService. Keyed as "session:<token>", value JSON { userId, createdAt,
// expiresAt }, with a native Redis TTL replacing this table's expiresAt
// filtering and removing the need for a cleanup job.
