// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Pinned: without this, generate infers the import extension from the
  // surrounding project. Inside the Docker builder, the generate postinstall
  // runs before tsconfig.json is copied in, and the inference picked ".ts" —
  // producing a client that crashes at runtime with "Cannot find module
  // './internal/class.ts'" (2026-07-10 outage).
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum BranchStatus {
  active
  inactive
}

enum LogoMode {
  shared
  perBranch
}

enum EmployeeStatus {
  active
  inactive
}

enum Sex {
  male
  female
}

enum WorkType {
  fullTime
  partTime
  trainee
}

enum MemberStatus {
  active
  inactive
}

enum PlanType {
  duration
  session
}

enum MembershipStatus {
  draft
  active
  frozen
  expired
  cancelled
}

enum AccessMethod {
  manual
  qr
  rfid
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  cancelled
}

enum PaymentMethod {
  cash
  card
  transfer
}

enum NotificationChannel {
  sms
  whatsapp
  email
  app
}

enum NotificationEvent {
  membershipExpiring
  membershipExpired
  paymentPending
  membershipActivated
  birthday
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum UserRole {
  owner
  manager
  frontDesk
}

enum ClassSessionStatus {
  scheduled
  cancelled
  completed
}

enum ClassBookingStatus {
  booked
  waitlisted
  attended
  noShow
  cancelled
}

enum LockerSize {
  small
  medium
  large
}

enum LockerStatus {
  available
  occupied
  maintenance
}

enum LockerRentalStatus {
  active
  expired
  cancelled
}

enum ProgramEnrollmentStatus {
  active
  cancelled
}

enum TenantStatus {
  active
  paused
}

// ── Tenant ───────────────────────────────────────────────────────────────────

model Tenant {
  id           String       @id
  name         String
  status       TenantStatus @default(active)
  pausedReason String?
  pausedAt     DateTime?
  createdAt    DateTime     @default(now())

  branches         Branch[]
  employees        Employee[]
  gates            Gate[]
  members          Member[]
  membershipPlans  MembershipPlan[]
  payments         Payment[]
  notifications    Notification[]
  settings         TenantSettings?
  users            User[]
  trainingPrograms TrainingProgram[]
  classSessions    ClassSession[]
  lockers          Locker[]
  announcements    Announcement[]
  closedDates      ClosedDate[]
  notificationTemplates NotificationTemplate[]
}

// Operator-level account for onboarding new tenants (SaaS admin). Deliberately
// has no tenantId/relation to Tenant — it's not a member of any gym's staff,
// just the platform operator's own login.
model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// ── Branches / Employees / Gates ─────────────────────────────────────────────

model Branch {
  id                    String       @id
  tenantId              String
  tenant                Tenant       @relation(fields: [tenantId], references: [id])
  name                  String
  address               String?
  phone                 String?
  countryCode           String?
  operatingCurrencyCode String       @default("ILS")
  status                BranchStatus @default(active)
  logoUrl               String?

  employees        Employee[]
  gates            Gate[]
  visits           Visit[]
  employeeVisits   EmployeeVisit[]
  membersAtHome    Member[]          @relation("MemberHomeBranch")
  payments         Payment[]
  trainingPrograms TrainingProgram[]
  classSessions    ClassSession[]
  lockers          Locker[]
  announcements    Announcement[]
  closedDates      ClosedDate[]

  @@index([tenantId])
}

model Employee {
  id             String         @id
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  employeeNumber String
  fullName       String
  status         EmployeeStatus @default(active)
  idNumber       String?
  phone          String?
  sex            Sex?
  dateOfBirth    DateTime?      @db.Date
  job            String?
  salary         Decimal?       @db.Decimal(10, 2)
  workType       WorkType?
  startDate      DateTime?      @db.Date
  endDate        DateTime?      @db.Date
  isUser         Boolean        @default(false)
  // Whether this employee's QR code opens every gate at their branch
  // (default) or only the gates explicitly listed in `gates` below —
  // mirrors MembershipPlan.allowAllBranches/allowAllPrograms: most
  // employees need no restriction, so the exception list only matters
  // once this is flipped false for a specific employee.
  allowAllGates  Boolean        @default(true)

  gates              EmployeeGate[]
  employeeVisits     EmployeeVisit[]
  registeredMembers  Member[]          @relation("MemberRegisteredEmployee")
  coachProfile       CoachProfile?
  defaultForPrograms TrainingProgram[]
  classSessions      ClassSession[]
  user               User?

  @@unique([tenantId, employeeNumber])
  @@index([branchId])
}

// A Coach is not a separate person record — it's an Employee extended with
// coaching-specific data, mirroring the TenantSettings-on-Tenant pattern.
// An employee becomes a coach by gaining this row, not by a new entity.
model CoachProfile {
  employeeId      String   @id
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  specializations String[]
  certifications  String[]
}

model Gate {
  id                String  @id
  tenantId          String
  tenant            Tenant  @relation(fields: [tenantId], references: [id])
  branchId          String
  branch            Branch  @relation(fields: [branchId], references: [id])
  name              String
  genderRestriction Sex?
  deviceUrl         String
  deviceUsername    String
  devicePassword    String
  lockNumber        Int
  enabled           Boolean @default(true)

  employees      EmployeeGate[]
  visits         Visit[]
  employeeVisits EmployeeVisit[]

  @@index([branchId])
}

// Exception list of gates an employee's QR may open, used only when
// Employee.allowAllGates is false (mirrors MembershipPlanProgram).
model EmployeeGate {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  gateId     String
  gate       Gate     @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@id([employeeId, gateId])
}

// Staff check-in/check-out, kept separate from Visit (which requires a
// Member) rather than loosening Visit.memberId's required FK.
model EmployeeVisit {
  id           String       @id
  employeeId   String
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  checkInTime  DateTime
  checkOutTime DateTime?
  accessMethod AccessMethod
  gateId       String?
  gate         Gate?        @relation(fields: [gateId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([branchId, checkInTime])
  @@index([employeeId, branchId, checkOutTime])
}

// ── Members / Memberships ────────────────────────────────────────────────────

model Member {
  id                    String        @id
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id])
  homeBranchId          String
  homeBranch            Branch        @relation("MemberHomeBranch", fields: [homeBranchId], references: [id])
  memberNumber          String
  fullName              String
  status                MemberStatus?
  phone                 String?
  email                 String?
  dateOfBirth           DateTime?     @db.Date
  sex                   Sex?
  idNumber              String?
  address               String?
  joinDate              DateTime?     @db.Date
  height                Float?
  weight                Float?
  registeredEmployeeId  String?
  registeredEmployee    Employee?     @relation("MemberRegisteredEmployee", fields: [registeredEmployeeId], references: [id], onDelete: SetNull)
  pictureUrl            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalNotes          String?
  rfidTag               String?
  // Hashed PIN a member uses to sign into the mobile app (scrypt, same
  // format as User.passwordHash). Null until staff assigns one — most
  // members won't have the mobile app, so this is opt-in per member.
  pinHash               String?
  // Cached total owed across every membership/locker-rental/course
  // enrollment minus every 'paid' payment — recomputed by DebtService
  // whenever any of those change (see modules/debt/debt.service.ts), not
  // hand-maintained. Never trust a stale read across a direct DB edit.
  debt                  Decimal       @default(0) @db.Decimal(10, 2)

  memberships        Membership[]
  visits             Visit[]
  payments           Payment[]
  notifications      Notification[]
  classBookings      ClassBooking[]
  programEnrollments ProgramEnrollment[]
  lockerRentals      LockerRental[]
  deviceTokens       MemberDeviceToken[]

  @@unique([tenantId, memberNumber])
  @@unique([tenantId, rfidTag])
  @@index([homeBranchId])
}

model MembershipPlan {
  id               String   @id
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  name             String
  planType         PlanType @default(duration)
  durationDays     Int?
  sessionCount     Int?
  price            Decimal  @db.Decimal(10, 2)
  allowAllBranches Boolean  @default(true)
  freezeAllowed    Boolean  @default(false)
  freezeMaxDays    Int?
  allowAllPrograms Boolean  @default(true)

  memberships      Membership[]
  entitledPrograms MembershipPlanProgram[]

  @@index([tenantId])
}

// Exception list of Training Programs a plan may book, used only when
// allowAllPrograms is false (mirrors allowAllBranches — most plans allow
// everything; premium/add-on plans restrict to specific programs).
model MembershipPlanProgram {
  planId    String
  plan      MembershipPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  programId String
  program   TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([planId, programId])
}

model Membership {
  id                   String           @id
  memberId             String
  member               Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId               String
  plan                 MembershipPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate            DateTime         @db.Date
  endDate              DateTime         @db.Date
  status               MembershipStatus
  finalPrice           Decimal          @db.Decimal(10, 2)
  previousMembershipId String?          @unique
  previousMembership   Membership?      @relation("MembershipRenewalChain", fields: [previousMembershipId], references: [id], onDelete: SetNull)
  renewedInto          Membership?      @relation("MembershipRenewalChain")

  freezes       Freeze[]
  payments      Payment[]
  classBookings ClassBooking[]

  @@index([memberId])
  @@index([planId])
  @@index([status, endDate])
}

model Freeze {
  id           String     @id
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  startDate    DateTime   @db.Date
  endDate      DateTime   @db.Date
  createdAt    DateTime   @default(now())

  @@index([membershipId])
}

// ── Lockers ──────────────────────────────────────────────────────────────────

// The physical locker unit at a branch — a limited resource (unlike
// MembershipPlan, which is an unlimited template), so it carries its own
// occupancy status rather than just being a catalog price.
model Locker {
  id           String       @id
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  branchId     String
  branch       Branch       @relation(fields: [branchId], references: [id])
  lockerNumber String
  size         LockerSize?
  monthlyPrice Decimal      @db.Decimal(10, 2)
  status       LockerStatus @default(available)

  rentals LockerRental[]

  @@unique([branchId, lockerNumber])
  @@index([tenantId])
}

model LockerRental {
  id         String             @id
  lockerId   String
  locker     Locker             @relation(fields: [lockerId], references: [id], onDelete: Restrict)
  memberId   String
  member     Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  startDate  DateTime           @db.Date
  endDate    DateTime           @db.Date
  status     LockerRentalStatus @default(active)
  finalPrice Decimal            @db.Decimal(10, 2)

  @@index([memberId])
  @@index([lockerId])
  @@index([status, endDate])
}

// ── Training Programs / Classes / Bookings ───────────────────────────────────

model TrainingProgram {
  id             String    @id
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  branchId       String? // null = global across the tenant's branches
  branch         Branch?   @relation(fields: [branchId], references: [id])
  name           String
  description    String?
  color          String?
  icon           String?
  active         Boolean   @default(true)
  maxMembers     Int?
  defaultCoachId String?
  defaultCoach   Employee? @relation(fields: [defaultCoachId], references: [id], onDelete: SetNull)
  // A course's own price, charged independently of any membership plan —
  // any member may register regardless of their membership (see
  // ProgramEnrollment.finalPrice). startDate/endDate bound the course term
  // that scheduleSlots are expanded into ClassSessions across.
  price          Decimal   @default(0) @db.Decimal(10, 2)
  startDate      DateTime? @db.Date
  endDate        DateTime? @db.Date

  classSessions    ClassSession[]
  entitledForPlans MembershipPlanProgram[]
  enrolledMembers  ProgramEnrollment[]
  scheduleSlots    ProgramScheduleSlot[]

  @@index([tenantId])
  @@index([branchId])
}

// A course's weekly timetable — one row per day/time it meets (e.g. Mon
// 18:00-19:00, Wed 18:00-19:00). generateSessions() expands these across
// the program's startDate..endDate into concrete ClassSessions.
model ProgramScheduleSlot {
  id        String          @id
  programId String
  program   TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday
  startTime DateTime        @db.Time
  endTime   DateTime        @db.Time

  @@index([programId])
}

// Standing registration of a member in a course, independent of any
// specific ClassSession booking (a member can be "in CrossFit" without being
// booked into a particular class time). finalPrice is the price owed for
// the course, snapshotted at registration time — same pattern as
// Membership.finalPrice / LockerRental.finalPrice; staff collect it via the
// existing manual Payments flow, there's no auto-generated ledger entry.
model ProgramEnrollment {
  memberId   String
  member     Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  programId  String
  program    TrainingProgram         @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrolledAt DateTime                @default(now())
  finalPrice Decimal                 @db.Decimal(10, 2)
  status     ProgramEnrollmentStatus @default(active)

  @@id([programId, memberId])
  @@index([memberId])
}

model ClassSession {
  id           String             @id
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  branchId     String
  branch       Branch             @relation(fields: [branchId], references: [id])
  programId    String
  program      TrainingProgram    @relation(fields: [programId], references: [id])
  coachId      String?
  coach        Employee?          @relation(fields: [coachId], references: [id], onDelete: SetNull)
  room         String?
  date         DateTime           @db.Date
  startTime    DateTime
  endTime      DateTime
  capacity     Int
  status       ClassSessionStatus @default(scheduled)
  recurrenceId String? // groups sessions generated from the same recurring rule

  bookings ClassBooking[]

  @@index([tenantId, branchId, date])
  @@index([coachId, date])
  @@index([recurrenceId])
}

model ClassBooking {
  id             String             @id
  classSessionId String
  classSession   ClassSession       @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // Historical/optional now that course bookings are authorized via
  // ProgramEnrollment rather than an active membership — see
  // ClassBookingsService.bookClass.
  membershipId   String?
  membership     Membership?        @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  status         ClassBookingStatus @default(booked)
  bookedAt       DateTime           @default(now())
  cancelledAt    DateTime?
  visitId        String?            @unique
  visit          Visit?             @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@unique([classSessionId, memberId])
  @@index([memberId])
  @@index([classSessionId, status])
}

// ── Visits / Payments / Notifications ────────────────────────────────────────

model Visit {
  id           String       @id
  memberId     String
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  checkInTime  DateTime
  checkOutTime DateTime?
  accessMethod AccessMethod
  gateId       String?
  gate         Gate?        @relation(fields: [gateId], references: [id], onDelete: SetNull)

  classBooking ClassBooking?

  @@index([memberId])
  @@index([branchId, checkInTime])
  @@index([memberId, branchId, checkOutTime])
}

model Payment {
  id            String        @id
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  memberId      String
  member        Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipId  String?
  membership    Membership?   @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(10, 2)
  paymentDate   DateTime
  status        PaymentStatus
  paymentMethod PaymentMethod

  @@index([tenantId, branchId])
  @@index([memberId])
  @@index([status, paymentDate])
}

model Notification {
  id           String              @id
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  memberId     String
  member       Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  channel      NotificationChannel
  event        NotificationEvent?
  relatedId    String?
  subject      String
  body         String              @db.Text
  status       NotificationStatus
  sentAt       DateTime?
  failedReason String?             @db.Text
  createdAt    DateTime            @default(now())

  @@index([tenantId, createdAt])
  @@index([memberId])
}

// Owner-editable subject/body per (templateKey, lang), overriding the
// in-code defaults in notification-templates-seed.ts. templateKey is looser
// than NotificationEvent on purpose: `membershipActivated` (initial sale)
// and `membershipRenewed` (renewal) fire under the same NotificationEvent
// (so they share one enable/channel rule in Settings) but need independently
// editable text, so template lookup keys off templateKey, not event.
model NotificationTemplate {
  id          String   @id
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  templateKey String
  lang        String
  subject     String
  body        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, templateKey, lang])
  @@index([tenantId])
}

// ── Settings ──────────────────────────────────────────────────────────────────

model TenantSettings {
  tenantId                String   @id
  tenant                  Tenant   @relation(fields: [tenantId], references: [id])
  defaultLanguage         String   @default("en")
  enabledLanguages        String[] @default(["en", "ar", "he"])
  notificationSettings    Json
  notificationSenders     Json     @default("{}")
  dateFormat              String   @default("dd/mm/yyyy")
  checkOutTrackingEnabled Boolean  @default(true)
  ownerDataScope          String   @default("all")
  reportingCurrencyCode   String   @default("ILS")
  logoMode                LogoMode @default(shared)
  logoUrl                 String?
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model User {
  id           String    @id
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  email        String
  username     String
  name         String
  role         UserRole
  passwordHash String
  branchId     String
  branchName   String
  // Optional 1:1 link to the person's Employee record (an account is an
  // optional extension of an employee, like CoachProfile — some users, e.g.
  // the owner, have no employee record). @unique = one account per employee.
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@unique([tenantId, username])
}

// Session records now live in Redis (see src/redis/), not Postgres — see
// AuthService. Keyed as "session:<token>", value JSON { userId, createdAt,
// expiresAt }, with a native Redis TTL replacing this table's expiresAt
// filtering and removing the need for a cleanup job.

// ── Mobile app: Announcements / Closed Dates / Push device tokens ───────────

// Tenant-wide (or single-branch) broadcast message, distinct from the
// per-member Notification model above — there's no per-event channel
// gating to apply since staff trigger this manually each time. Creating one
// fans out a push send to every matching MemberDeviceToken; pushSentCount/
// pushFailedCount are cached here rather than tracked per-recipient.
model Announcement {
  id              String   @id
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  branchId        String? // null = tenant-wide
  branch          Branch?  @relation(fields: [branchId], references: [id])
  title           String
  body            String   @db.Text
  pushSentCount   Int      @default(0)
  pushFailedCount Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([tenantId, createdAt])
}

// A day the gym (or one branch) is closed, shown on the mobile app's
// closed-dates calendar.
model ClosedDate {
  id        String   @id
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  branchId  String? // null = tenant-wide
  branch    Branch?  @relation(fields: [branchId], references: [id])
  date      DateTime @db.Date
  reason    String
  createdAt DateTime @default(now())

  @@index([tenantId, date])
}

// FCM device token registered by a member's phone via POST /me/device-token.
// A member may have more than one (multiple devices) — unique per token so
// re-registering the same device is an upsert, not a duplicate row.
model MemberDeviceToken {
  id         String   @id
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  token      String
  platform   String? // "android" | "ios"
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@unique([memberId, token])
  @@index([memberId])
}
